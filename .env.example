# ── Auth mode ─────────────────────────────────────────────────────────────
# passthrough (default): Intervals.icu is the AS, Claude talks to it directly.
# Requires Intervals.icu to offer a public-client OAuth app (PKCE, no secret).
# This server never sees the token.
# proxy: use only if Intervals.icu requires a confidential client. This server
# relays the code/token exchange but STILL doesn't persist or log anything.
AUTH_MODE=passthrough

# ── Only if AUTH_MODE=proxy ──────────────────────────────────────────────
# Credentials of the OAuth app registered with Intervals.icu (confidential client).
INTERVALS_CLIENT_ID=
INTERVALS_CLIENT_SECRET=
# Intervals.icu AS endpoints (adjust once confirmed on their end).
# Confirmed by direct testing: /oauth/authorize is the login+consent page (frontend),
# but the token exchange lives under /api/ — /oauth/token (without /api/) returns 405
# (falls into the SPA catch-all), not a real endpoint.
INTERVALS_OAUTH_AUTHORIZE_URL=https://intervals.icu/oauth/authorize
INTERVALS_OAUTH_TOKEN_URL=https://intervals.icu/api/oauth/token
# Scopes confirmed at forum.intervals.icu/t/intervals-icu-oauth-support/2759:
# ACTIVITY, WELLNESS, CALENDAR, CHATS, LIBRARY, SETTINGS (each with :READ or :WRITE,
# WRITE implies READ). This set covers everything the tools use today — see the
# detail in lib/intervals-oauth.js. LIBRARY is left out (unused). The scope for
# coach mode (multi-athlete listing) still isn't confirmed on Intervals.icu's end.
INTERVALS_OAUTH_SCOPE=ACTIVITY:WRITE,WELLNESS:WRITE,CALENDAR:WRITE,CHATS:WRITE,SETTINGS:WRITE

# Key to seal (encrypt) the ephemeral OAuth flow state in proxy mode — this is
# NOT credential custody, it just avoids depending on storage between steps.
# Generate with: openssl rand -hex 32
RELAY_SEAL_KEY=

# ── passthrough only: which AS oauth-protected-resource points at ─────────
INTERVALS_OAUTH_ISSUER=https://intervals.icu

# Optional: override the public deploy URL used to build OAuth metadata and
# shown on /. Both are derived from the incoming request by default — only set
# these if you need to force a specific domain (e.g. behind a proxy that
# strips the original host).
NEXT_PUBLIC_MCP_URL=
AUTH_URL=
