# ── Cifrado de API keys de Intervals (AES-256-GCM) ──────────────────────────
# Generar con:  openssl rand -hex 32
ENCRYPTION_KEY=

# ── Store (KV) ──────────────────────────────────────────────────────────────
# Upstash Redis (o Vercel KV vía marketplace, que inyecta estas mismas vars).
# Si están vacías en local, el store cae a un archivo .data/store.json (SOLO dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Google login (solo para el enroll web self-serve) ───────────────────────
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# openssl rand -base64 32
AUTH_SECRET=

# Emails habilitados para darse de alta por la web, separados por coma.
ALLOWED_EMAILS=
# El admin siempre puede entrar (y es el dueño de la CLI).
ADMIN_EMAIL=

# URL pública del deploy (para las instrucciones del connector que muestra /connect).
NEXT_PUBLIC_MCP_URL=https://mcp.gregaria.app/api/mcp
